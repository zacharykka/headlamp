# Headlamp environment variables template
# Copy to headlamp.env (or .env alongside docker-compose.yml) and restrict permissions:
#   chmod 600 headlamp.env

# 32-byte AES-256-GCM encryption key (64 hex chars or base64).
# Required for stable decryption across container rebuilds and mandatory across PostgreSQL replicas.
# Generate with: openssl rand -hex 32
HEADLAMP_MASTER_KEY=

# Headscale control server URL (leave empty when joining official Tailscale SaaS)
HEADLAMP_CONTROL_URL=https://headscale.example.com

# Pre-auth key for initial tsnet node registration (can be removed once tailscaled.state is persisted)
HEADLAMP_AUTH_KEY=

# Persistent state directory for tsnet identity & auto-generated master.key:
# - Docker Compose uses /data (mapped to a volume)
# - systemd binary deployments typically use /var/lib/headlamp
# HEADLAMP_STATE_DIR=/data
# HEADLAMP_STORAGE_DSN=/data/headlamp.db

# Upstream provider API keys referenced via ${VAR} in headlamp.yaml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional ACME DNS-01 HTTPS settings (when exposing https://<domain> on your tailnet)
# HEADLAMP_TLS_MODE=acme_dns01
# HEADLAMP_TLS_DOMAIN=headlamp.tailnet.internal
# HEADLAMP_TLS_ACME_EMAIL=ops@example.com
# HEADLAMP_TLS_DNS_PROVIDER=cloudflare
# HEADLAMP_TLS_DNS_API_TOKEN=
# HEADLAMP_STARTUP_TIMEOUT=5m

# Required only when using deploy/docker-compose.postgres.yml or HEADLAMP_STORAGE_DRIVER=postgres
# HEADLAMP_PG_PASSWORD=
